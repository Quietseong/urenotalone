# ====================================================================
# 도리 PoC 환경 변수 템플릿
# 이 파일을 복사해서 .env.local 이름으로 저장한 뒤 값만 채워주세요.
#   cp .env.local.example .env.local
# ====================================================================

# --------------------------------------------------------------------
# [필수] Google Gemini — 대화 응답에 사용되는 LLM
# 발급 위치: https://aistudio.google.com/apikey
#   1. Google 계정으로 로그인
#   2. "Create API key" 클릭
#   3. 무료 quota 충분 (Gemini 3.1 Flash Lite 기준 분당 수십 회 호출 가능)
# --------------------------------------------------------------------
GEMINI_API_KEY=

# (선택) 사용할 모델 override. 기본값: gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite

# --------------------------------------------------------------------
# [선택 — Cycle 2 예정] Google Cloud Text-to-Speech (ko-KR Neural2 보이스)
# 현재 cycle 1에서는 브라우저 내장 Web Speech API로 TTS를 처리하므로
# 이 키는 비워둬도 앱이 정상 동작합니다.
# 발급 위치: https://console.cloud.google.com/ → APIs & Services → Credentials
#   1. "Create API key"
#   2. 권한 제한 권장: "Cloud Text-to-Speech API"만 허용
# --------------------------------------------------------------------
GOOGLE_TTS_API_KEY=

# (대안) Service account JSON 사용 시 — Cycle 2 SDK 사용 가정
# GOOGLE_APPLICATION_CREDENTIALS=

# --------------------------------------------------------------------
# [선택 — Cycle 2 예정] Resend — 보호자 이메일 실제 발송
# 현재 cycle 1에서는 /parent 라우트에서 mock view만 제공하므로
# 이 키는 비워둬도 앱이 정상 동작합니다.
# 발급 위치: https://resend.com/api-keys
# --------------------------------------------------------------------
RESEND_API_KEY=

# Resend 발신 주소. 도메인 미보유 시 onboarding@resend.dev 사용 가능
RESEND_FROM_EMAIL=
